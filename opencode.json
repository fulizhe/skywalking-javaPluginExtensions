{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "plugin": [
    "opencode-worktree",
    "oh-my-openagent"
  ],
  "mcp": {
    "codegraph": {
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}