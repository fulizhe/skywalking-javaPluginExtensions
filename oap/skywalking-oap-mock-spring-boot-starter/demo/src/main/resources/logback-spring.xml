<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- 控制台:带 traceId,便于对照页面 -->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level [%X{tid}] %logger{36} - %msg%n</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- 通过 agent 的 gRPC 通道把日志上报到 collector(默认 127.0.0.1:11800)。
	     需要 apm-toolkit-logback-1.x 在 classpath 上,并用 -javaagent 启动本应用。 -->
	<appender name="SW_GRPC" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
		<encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
			<layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
				<Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid}] [%thread] %-5level %logger{36} - %msg%n</Pattern>
			</layout>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="STDOUT"/>
		<appender-ref ref="SW_GRPC"/>
	</root>
</configuration>
