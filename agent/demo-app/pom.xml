<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>org.openskywalking</groupId>
    <artifactId>demo-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>demo-app</name>
    <description>插件验证演示应用与验证台:logfile-reporter-plugin 能力演示 + 一条命令验证回路</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>1.8</java.version>
        <!-- 与 agent 发行包版本强一致(见 scripts/run-with-agent.ps1 的 agent 目录约定) -->
        <skywalking.toolkit.version>9.4.0</skywalking.toolkit.version>
        <!-- verify 版本矩阵可变点:覆盖 Spring Boot 管理的 Apache HttpClient 版本(见 verify/scenarios/override-httpclient/support-version.list) -->
        <httpclient.version>4.5.14</httpclient.version>
        <!-- verify 版本矩阵可变点:hutool 出口(override-hutool-http-5.x-plugin 的增强目标 cn.hutool.http.HttpRequest)
             须真实存在于应用 classpath,故 demo-app 依赖 hutool-http;core/json 随 `${hutool.version}` 一并对齐,
             避免 hutool-http 传递的 core 版本与显式声明的 json 版本打架。默认值与插件模块 hutool.version 一致。 -->
        <hutool.version>5.4.1</hutool.version>
        <!-- 依赖拓扑演示的中间件客户端版本;取值须落在 agent 9.4.0 插件 support 范围内
             (jedis-2.x-3.x / mysql-8.x / kafka-0.11.x~2.x),超范围会静默不生效。见 pom 里的注释。 -->
        <jedis.version>3.8.0</jedis.version>
        <kafka.version>2.8.2</kafka.version>
        <!-- RPC 样例的 gRPC 客户端版本;必须落在 agent apm-grpc-1.x 插件的 support 范围内(1.x),超范围静默不生效 -->
        <grpc.version>1.58.0</grpc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 应用日志流:logback 1.x toolkit appender,agent 挂载后日志进入 agent 的 LogReportServiceClient -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-logback-1.x</artifactId>
            <version>${skywalking.toolkit.version}</version>
        </dependency>

        <!-- meter 指标流:micrometer 桥接,toolkit 编译于 micrometer 1.5,排除后由 spring-boot 管理版本(2.7.x 线为 1.9.x,API 兼容) -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-micrometer-registry</artifactId>
            <version>${skywalking.toolkit.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- 插件拦截器运行时引用 hutool(core 经 json 传递);与插件模块 hutool.version 5.4.1 对齐,
             挂载 agent 时插件类经 PluginClassLoader 回落到应用类路径解析 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- override-hutool-http-5.x 插件的增强目标(cn.hutool.http.HttpRequest#execute):应用侧真实出口,
             供 verify/scenarios/override-hutool 端到端断言(见 HutoolHttpDemoController) -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-http</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- trace 告警验证:httpclient exit span(agent httpclient 插件可观测),版本由 spring-boot 管理 -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>

        <!-- 初学者演示:显式 @Trace/@Tag/@ActiveSpan 等注解(apm-toolkit-logback-1.x 已传递引入,此处显式声明) -->
        <dependency>
            <groupId>org.apache.skywalking</groupId>
            <artifactId>apm-toolkit-trace</artifactId>
            <version>${skywalking.toolkit.version}</version>
        </dependency>

        <!-- 初学者演示:MyBatis + JdbcTemplate 双路 SQL 可观测 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 初学者演示:knife4j 文档页(/doc.html),与旧 demo 工程 2.0.8 对齐 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-micro-spring-boot-starter</artifactId>
            <version>2.0.8</version>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-spring-ui</artifactId>
            <version>2.0.8</version>
        </dependency>
        <!-- springfox 2.10 的 BeanValidatorPluginsConfiguration 依赖 javax.validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 依赖拓扑演示(票 02):三类中间件客户端,喂 Cache / Database / MQ 三层依赖边。
             agent 侧插件已就位,宿主组件库已收录 Redis / MySQL / Kafka,故组件名零改动。
             版本**刻意对齐 agent 9.4.0 插件的 support范围**(实测读 plugins/*.jar 的 plugin.def):
               - jedis 3.8.x  → jedis-2.x-3.x-plugin   (不用 lettuce:插件只匹配 lettuce-5.x,
                 而 Spring Boot 2.7 管理的 lettuce 是 6.x,版本不匹配会**静默不生效**)
               - mysql-connector-java 8.0.x → mysql-8.x-plugin
               - kafka-clients 2.8.x → kafka-0.11.x/1.x/2.x  (3.x 不在范围内;3.7.x 是另一条定义)
             **中间件不在场也照调** —— 连不上照样出依赖边(红边),见 DepsDemoController。 -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <!-- 刻意用原生 kafka-clients 而非 spring-kafka:少一层自动配置,超时更可控 -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>

                <!-- RPC 样例(依赖拓扑的 gRPC 节点):进程内起一个最小 gRPC server 并自调用,补上此前
             Database/Cache/MQ/Http 之外的第四类。刻意不引外部中间件,也不写 .proto ——
             手工 MethodDescriptor + byte[] 直通即可(见 GrpcDemoServer 的类注释)。
             版本必须落在 agent 9.4.0 `apm-grpc-1.x` 插件的 support 范围(grpc 1.x),
             超范围会**静默不生效** —— 图上就是没有 gRPC 节点。Spring Boot 2.7 不代管 grpc 版本,故显式钉。 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>

        <!-- @Slf4j/@Getter 等 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 自包含压测（org.openskywalking.demo.load.HttpLoadTest）:JUnit 5 条件启用，默认不跑 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
