<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
		<groupId>org.openskywalking</groupId>
		<artifactId>java-plugin-extensions</artifactId>
		<version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>logfile-reporter-plugin</artifactId>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- H2 版本与 OAP 9.4 / 实验环境一致;shade 重定位 org.h2 前缀以避免与业务自带 H2 冲突 -->
        <h2.version>2.1.212</h2.version>
    </properties>

	<dependencies>
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-json</artifactId>
			<version>${hutool.version}</version>			
		</dependency>
		<!-- H2 影子存储依赖:经 maven-shade-plugin 重定位 org.h2 -> org.apache.skywalking.apm.dependencies.h2,
		     打入插件 jar,不依赖应用 classpath;hutool-json 则沿用编译期声明 + 运行期经 PluginClassLoader 回落到应用 classpath 的既有策略 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- 版本由父 pom pluginManagement 统一为 3.x;apm-agent 在 fork 子进程里可能导致 Surefire 误判 VM 异常退出，同进程执行更稳定 -->
			        <!-- 不创建独立子 JVM 进程，所有测试直接运行在 Maven 主进程（Maven 本身的 JVM）内部 -->
			        <!--
			            forkCount=0 = 牺牲运行隔离换取启动速度；
			            适合：本地临时调试、小型简单单元测试；
			            不适合：集成测试、SpringBoot 容器测试、CI 流水线、需要 javaagent/JaCoCo、存在静态变量 / 系统属性修改的项目。
					-->
					<forkCount>0</forkCount>
					<includes>
						<include>**/*Test.java</include>
					</includes>
				</configuration>
			</plugin>
			<!-- H2 shade 重定位:只打 com.h2database:h2,不卷 hutool-json(后者运行期经 PluginClassLoader 回落到应用 classpath) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- 替换主产物(不附加 shaded 分类器),agent plugins/ 目录只放一个 jar -->
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<!-- 不生成 dependency-reduced pom,避免 reactor 依赖解析混乱 -->
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- 只打 H2,不卷其他依赖 -->
							<artifactSet>
								<includes>
									<include>com.h2database:h2</include>
								</includes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>org.h2</pattern>
									<shadedPattern>org.apache.skywalking.apm.dependencies.h2</shadedPattern>
								</relocation>
							</relocations>
							<!-- 合并 META-INF/services(更新 JDBC Driver 服务注册到重定位后的类名) -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>
								<filter>
									<artifact>com.h2database:h2</artifact>
									<excludes>
										<exclude>META-INF/maven/**</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
