<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
		<groupId>org.openskywalking</groupId>
		<artifactId>java-plugin-extensions</artifactId>
		<version>1.0.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>logfile-reporter-plugin</artifactId>
    <version>2.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- H2 版本与 OAP 9.4 / 实验环境一致;shade 重定位 org.h2 前缀以避免与业务自带 H2 冲突 -->
        <h2.version>2.1.212</h2.version>
        <!-- 告警 webhook 的 HTTP 客户端。必须自带而不用 HttpURLConnection:
             后者的连接复用依赖 JDK 隐式的 KeepAliveCache,在 agent 的 PluginClassLoader
             运行时里实测失效(1 条告警 = 1 条新 TCP 连接,高频错误下打满本机动态端口池,
             连带把不相关的仪表盘页面打挂)。详见 docs/adr/adr-05-*.md -->
        <httpclient.version>4.5.13</httpclient.version>
        <httpcore.version>4.4.13</httpcore.version>
        <commons.logging.version>1.2</commons.logging.version>
        <!-- 池化连接数上限。单线程消费 + 顺序发请求,2~4 条足够;定成小值是为了让
             "连接数有硬上界"成为可验证的性质,而不是依赖对端行为 -->
        <webhook.pool.max.total>4</webhook.pool.max.total>
    </properties>

	<dependencies>
		<dependency>
			<groupId>cn.hutool</groupId>
			<artifactId>hutool-json</artifactId>
			<version>${hutool.version}</version>			
		</dependency>
		<!-- H2 影子存储依赖:经 maven-shade-plugin 重定位 org.h2 -> org.apache.skywalking.apm.dependencies.h2,
		     打入插件 jar,不依赖应用 classpath;hutool-json 则沿用编译期声明 + 运行期经 PluginClassLoader 回落到应用 classpath 的既有策略 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<version>${h2.version}</version>
		</dependency>
		<!-- 告警 webhook 专用:显式池化,连接数有硬上界。必须 shade 重定位,
		     否则会与业务 classpath 里的 httpclient 争版本(agent plugins/ 与应用 classpath 是两个 ClassLoader) -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>${httpclient.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpcore</artifactId>
			<version>${httpcore.version}</version>
		</dependency>
		<!-- commons-logging 是 httpclient 的**运行期**硬依赖(org.apache.http.conn.ssl.AbstractVerifier
		     静态初始化就要 LogFactory),不是可选传递依赖 —— 漏了会在 HttpClients.custom() 时抛
		     NoClassDefFoundError。它同时也是最常与业务 classpath 撞车的包,故显式声明并一并 shade。 -->
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
			<version>${commons.logging.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- 版本由父 pom pluginManagement 统一为 3.x;apm-agent 在 fork 子进程里可能导致 Surefire 误判 VM 异常退出，同进程执行更稳定 -->
			        <!-- 不创建独立子 JVM 进程，所有测试直接运行在 Maven 主进程（Maven 本身的 JVM）内部 -->
			        <!--
			            forkCount=0 = 牺牲运行隔离换取启动速度；
			            适合：本地临时调试、小型简单单元测试；
			            不适合：集成测试、SpringBoot 容器测试、CI 流水线、需要 javaagent/JaCoCo、存在静态变量 / 系统属性修改的项目。
					-->
					<forkCount>0</forkCount>
					<includes>
						<include>**/*Test.java</include>
					</includes>
				</configuration>
			</plugin>
			<!-- 从 h2 artifact 里取出嵌套的 org/h2/util/data.zip(Web Console 静态资源 + 消息包),
			     供下一步 antrun 展开到 shade 重定位后的资源路径 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>unpack-h2-data-zip</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.h2database</groupId>
									<artifactId>h2</artifactId>
									<version>${h2.version}</version>
									<includes>org/h2/util/data.zip</includes>
									<outputDirectory>${project.build.directory}/h2-data</outputDirectory>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- 展开 data.zip,并把 org/h2/** 资源改写到 shade 后的 org/apache/skywalking/apm/dependencies/h2/**。
			     H2 的 Utils.loadResource 找不到 Utils 同包的 data.zip 时,会回落到 classpath 直接读 name 对应资源;
			     故把资源平铺到重定位路径即可被正确的字符串常量命中。 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>expand-h2-data-zip</id>
						<phase>process-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<unzip src="${project.build.directory}/h2-data/org/h2/util/data.zip"
								       dest="${project.build.directory}/h2-data-expanded"/>
								<copy todir="${project.build.outputDirectory}/org/apache/skywalking/apm/dependencies/h2">
									<fileset dir="${project.build.directory}/h2-data-expanded/org/h2"/>
								</copy>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- H2 shade 重定位:只打 com.h2database:h2,不卷 hutool-json(后者运行期经 PluginClassLoader 回落到应用 classpath) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- 替换主产物(不附加 shaded 分类器),agent plugins/ 目录只放一个 jar -->
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<!-- 不生成 dependency-reduced pom,避免 reactor 依赖解析混乱 -->
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- 只打 H2 + httpclient/httpcore,不卷其他依赖 -->
							<artifactSet>
								<includes>
									<include>com.h2database:h2</include>
									<include>org.apache.httpcomponents:httpclient</include>
									<include>org.apache.httpcomponents:httpcore</include>
									<include>commons-logging:commons-logging</include>
								</includes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>org.h2</pattern>
									<shadedPattern>org.apache.skywalking.apm.dependencies.h2</shadedPattern>
								</relocation>
								<!-- httpclient/httpcore 一并重定位:agent plugins/ 与应用 classpath 是两个 ClassLoader,
								     但 httpclient 常被业务自带(且版本各异),不重定位迟早撞 NoSuchMethodError -->
								<relocation>
									<pattern>org.apache.http</pattern>
									<shadedPattern>org.apache.skywalking.apm.dependencies.http</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.apache.commons</pattern>
									<shadedPattern>org.apache.skywalking.apm.dependencies.commons</shadedPattern>
								</relocation>
							</relocations>
							<!-- 合并 META-INF/services(更新 JDBC Driver 服务注册到重定位后的类名) -->
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
							<filters>
								<filter>
									<artifact>com.h2database:h2</artifact>
									<excludes>
										<exclude>META-INF/maven/**</exclude>
										<!-- H2 把 Web Console 静态资源与消息包塞在嵌套的 org/h2/util/data.zip 里;
										     shade 只会重定位"资源路径"本身,不会改写 data.zip 内部条目名,导致
										     Utils.getResource("/org/apache/.../dependencies/h2/res/x") 查不到(shade 已把
										     代码里的路径字符串改成新前缀,而 zip 内条目仍是 org/h2/...)。此处剔除该嵌套 zip,
										     改由下方 dependency:unpack + antrun 展开到重定位后的资源路径。 -->
										<exclude>org/h2/util/data.zip</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
